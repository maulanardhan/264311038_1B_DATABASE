
CREATE TABLE pemilik ( 
id_pemilik INT UNSIGNED NOT NULL AUTO_INCREMENT,
 nama_pemilik VARCHAR(100) NOT NULL, 
CONSTRAINT pk_pemilik PRIMARY KEY (id_pemilik) 
) ENGINE=InnoDB;

CREATE TABLE kasir ( 
id_kasir INT UNSIGNED NOT NULL AUTO_INCREMENT, 
nama_kasir VARCHAR(100) NOT NULL, 
shift VARCHAR(10) NOT NULL, 
CONSTRAINT pk_kasir PRIMARY KEY (id_kasir),
CONSTRAINT chk_kasir_shift CHECK (shift IN ('Pagi', 'Siang', 'Malam'))
) ENGINE=InnoDB;

CREATE TABLE supplier (
id_supplier INT UNSIGNED NOT NULL AUTO_INCREMENT, 
nama_supplier VARCHAR(100) NOT NULL,
no_telepon VARCHAR(20) NOT NULL,
CONSTRAINT pk_supplier PRIMARY KEY (id_supplier),
CONSTRAINT chk_supplier_telepon CHECK (no_telepon REGEXP '^[+]?[0-9]{8,15}$')
 ) ENGINE=InnoDB;

CREATE TABLE barang (
id_barang INT UNSIGNED NOT NULL AUTO_INCREMENT, 
nama_barang VARCHAR(100) NOT NULL, 
harga_jual DECIMAL(12,2) NOT NULL, 
stok INT NOT NULL DEFAULT 0, 
CONSTRAINT pk_barang PRIMARY KEY (id_barang), 
CONSTRAINT chk_barang_harga CHECK (harga_jual >= 0), 
CONSTRAINT chk_barang_stok CHECK (stok >= 0) 
) ENGINE=InnoDB;


CREATE TABLE transaksi ( 
id_transaksi INT UNSIGNED NOT NULL AUTO_INCREMENT, 
tanggal DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP, 
id_kasir INT UNSIGNED NOT NULL, 
CONSTRAINT pk_transaksi PRIMARY KEY (id_transaksi), 
CONSTRAINT fk_transaksi_kasir 
FOREIGN KEY (id_kasir) REFERENCES kasir (id_kasir) 
ON DELETE RESTRICT ON UPDATE CASCADE
) ENGINE=InnoDB;

CREATE TABLE detail_transaksi ( 
id_transaksi INT UNSIGNED NOT NULL,
 id_barang INT UNSIGNED NOT NULL, 
jumlah INT NOT NULL, 
_jual DECIMAL(12,2) NOT NULL, 
CONSTRAINT pk_detail_transaksi PRIMARY KEY (id_transaksi, id_barang), 
CONSTRAINT fk_dtrans_transaksi 
FOREIGN KEY (id_transaksi) REFERENCES transaksi (id_transaksi)
ON DELETE CASCADE ON UPDATE CASCADE, 
CONSTRAINT fk_dtrans_barang 
FOREIGN KEY (id_barang) REFERENCES barang (id_barang) ON DELETE RESTRICT ON UPDATE CASCADE, CONSTRAINT chk_dtrans_jumlah CHECK (jumlah > 0), 
CONSTRAINT chk_dtrans_harga CHECK (harga_jual >= 0) 
) ENGINE=InnoDB;

CREATE TABLE barang_masuk ( 
id_masuk INT UNSIGNED NOT NULL AUTO_INCREMENT, 
tanggal_masuk DATE NOT NULL, 
no_surat_jalan VARCHAR(30) NOT NULL, 
id_supplier INT UNSIGNED NOT NULL, 
CONSTRAINT pk_barang_masuk PRIMARY KEY (id_masuk), 
CONSTRAINT uq_barang_masuk_sj UNIQUE (no_surat_jalan), 
CONSTRAINT fk_bmasuk_supplier 
FOREIGN KEY (id_supplier) REFERENCES supplier (id_supplier) ON DELETE RESTRICT ON UPDATE CASCADE ) 
ENGINE=InnoDB;

CREATE TABLE detail_masuk ( 
id_masuk INT UNSIGNED NOT NULL, 
id_barang INT UNSIGNED NOT NULL, 
jumlah_masuk INT NOT NULL, 
CONSTRAINT pk_detail_masuk PRIMARY KEY (id_masuk, id_barang), 
CONSTRAINT fk_dmasuk_masuk 
FOREIGN KEY (id_masuk) REFERENCES barang_masuk (id_masuk) 
ON DELETE CASCADE ON UPDATE CASCADE, 
CONSTRAINT fk_dmasuk_barang FOREIGN KEY (id_barang) REFERENCES barang (id_barang) ON DELETE RESTRICT ON UPDATE CASCADE,
 CONSTRAINT chk_dmasuk_jumlah CHECK (jumlah_masuk > 0) 
) ENGINE=InnoDB;

CREATE TABLE retur_pelanggan ( 
id_retur INT UNSIGNED NOT NULL AUTO_INCREMENT, 
tanggal_retur DATE NOT NULL, 
alasan VARCHAR(255) NOT NULL, 
jumlah_retur INT NOT NULL, 
id_transaksi INT UNSIGNED NOT NULL,
id_barang INT UNSIGNED NOT NULL, 
id_pemilik INT UNSIGNED NOT NULL, 
CONSTRAINT pk_retur PRIMARY KEY (id_retur), 
CONSTRAINT fk_retur_transaksi 
FOREIGN KEY (id_transaksi) REFERENCES transaksi (id_transaksi) 
ON DELETE RESTRICT ON UPDATE CASCADE, 
CONSTRAINT fk_retur_barang FOREIGN KEY (id_barang) REFERENCES barang (id_barang) 
ON DELETE RESTRICT ON UPDATE CASCADE, 
CONSTRAINT fk_retur_pemilik FOREIGN KEY (id_pemilik) REFERENCES pemilik (id_pemilik) 
ON DELETE RESTRICT ON UPDATE CASCADE, 
CONSTRAINT chk_retur_jumlah CHECK (jumlah_retur > 0) 
) ENGINE=InnoDB;

CREATE INDEX 
idx_transaksi_tanggal ON transaksi (tanggal); CREATE INDEX 
idx_barang_nama ON barang (nama_barang); CREATE INDEX 
idx_retur_tanggal ON retur_pelanggan (tanggal_retur);

CREATE VIEW v_detail_transaksi AS SELECT 
d.id_transaksi, 
d.id_barang, 
b.nama_barang, 
d.jumlah, 
d.harga_jual, 
d.jumlah *
 d.harga_jual AS subtotal 
FROM detail_transaksi d 
JOIN barang b ON b.id_barang = d.id_barang;

CREATE VIEW v_transaksi_total AS 
SELECT t.id_transaksi, 
t.tanggal, 
t.id_kasir, 
COALESCE(SUM(d.jumlah * d.harga_jual), 0) AS total 
FROM transaksi t 
LEFT JOIN detail_transaksi d ON d.id_transaksi = t.id_transaksi 
GROUP BY t.id_transaksi, t.tanggal, t.id_kasir;

