CREATE DATABASE IF NOT EXISTS db_retail
  CHARACTER SET utf8mb4
  COLLATE utf8mb4_general_ci;
USE db_retail;

SET FOREIGN_KEY_CHECKS = 0;
DROP TABLE IF EXISTS retur_pelanggan;
DROP TABLE IF EXISTS penyesuaian_stok;
DROP TABLE IF EXISTS detail_transaksi;
DROP TABLE IF EXISTS detail_masuk;
DROP TABLE IF EXISTS transaksi;
DROP TABLE IF EXISTS barang_masuk;
DROP TABLE IF EXISTS barang;
DROP TABLE IF EXISTS supplier;
DROP TABLE IF EXISTS kasir;
DROP TABLE IF EXISTS pemilik;
DROP VIEW IF EXISTS v_transaksi_total;
SET FOREIGN_KEY_CHECKS = 1;

-- 1. PEMILIK
CREATE TABLE pemilik (
  id_pemilik   VARCHAR(10)  NOT NULL,
  nama_pemilik VARCHAR(100) NOT NULL,
  PRIMARY KEY (id_pemilik)
) ENGINE=InnoDB;

-- 2. KASIR
CREATE TABLE kasir (
  id_kasir   VARCHAR(10)  NOT NULL,
  nama_kasir VARCHAR(100) NOT NULL,
  shift      ENUM('Pagi','Siang','Malam') NOT NULL,
  PRIMARY KEY (id_kasir)
) ENGINE=InnoDB;

-- 3. SUPPLIER
CREATE TABLE supplier (
  id_supplier   VARCHAR(10)  NOT NULL,
  nama_supplier VARCHAR(100) NOT NULL,
  no_telepon    VARCHAR(20)  NOT NULL,
  PRIMARY KEY (id_supplier),
  UNIQUE KEY uq_supplier_telp (no_telepon)
) ENGINE=InnoDB;

-- 4. BARANG
CREATE TABLE barang (
  id_barang   VARCHAR(10)   NOT NULL,
  nama_barang VARCHAR(100)  NOT NULL,
  harga_jual  DECIMAL(12,2) NOT NULL,
  stok        INT           NOT NULL DEFAULT 0,
  PRIMARY KEY (id_barang),
  CONSTRAINT chk_barang_harga CHECK (harga_jual >= 0),
  CONSTRAINT chk_barang_stok  CHECK (stok >= 0)
) ENGINE=InnoDB;

-- 5. BARANG_MASUK (Supplier 1 -- N Barang Masuk : MENGIRIM)
CREATE TABLE barang_masuk (
  id_masuk       VARCHAR(10) NOT NULL,
  tanggal_masuk  DATE        NOT NULL,
  no_surat_jalan VARCHAR(50) NOT NULL,
  id_supplier    VARCHAR(10) NOT NULL,
  PRIMARY KEY (id_masuk),
  UNIQUE KEY uq_surat_jalan (no_surat_jalan),
  CONSTRAINT fk_masuk_supplier FOREIGN KEY (id_supplier)
    REFERENCES supplier (id_supplier)
    ON UPDATE CASCADE ON DELETE RESTRICT
) ENGINE=InnoDB;

-- 6. DETAIL_MASUK (Barang Masuk M -- N Barang)
CREATE TABLE detail_masuk (
  id_masuk     VARCHAR(10) NOT NULL,
  id_barang    VARCHAR(10) NOT NULL,
  jumlah_masuk INT         NOT NULL,
  PRIMARY KEY (id_masuk, id_barang),
  CONSTRAINT fk_dm_masuk FOREIGN KEY (id_masuk)
    REFERENCES barang_masuk (id_masuk)
    ON UPDATE CASCADE ON DELETE CASCADE,
  CONSTRAINT fk_dm_barang FOREIGN KEY (id_barang)
    REFERENCES barang (id_barang)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT chk_dm_jumlah CHECK (jumlah_masuk > 0)
) ENGINE=InnoDB;

-- 7. TRANSAKSI (Kasir 1 -- N Transaksi : MENCATAT)
CREATE TABLE transaksi (
  id_transaksi VARCHAR(10) NOT NULL,
  tanggal      DATETIME    NOT NULL DEFAULT CURRENT_TIMESTAMP,
  id_kasir     VARCHAR(10) NOT NULL,
  PRIMARY KEY (id_transaksi),
  CONSTRAINT fk_transaksi_kasir FOREIGN KEY (id_kasir)
    REFERENCES kasir (id_kasir)
    ON UPDATE CASCADE ON DELETE RESTRICT
) ENGINE=InnoDB;

-- 8. DETAIL_TRANSAKSI (Transaksi M -- N Barang), subtotal = atribut turunan
CREATE TABLE detail_transaksi (
  id_transaksi VARCHAR(10)   NOT NULL,
  id_barang    VARCHAR(10)   NOT NULL,
  jumlah       INT           NOT NULL,
  harga_jual   DECIMAL(12,2) NOT NULL,
  subtotal     DECIMAL(14,2) GENERATED ALWAYS AS (jumlah * harga_jual) STORED,
  PRIMARY KEY (id_transaksi, id_barang),
  CONSTRAINT fk_dt_transaksi FOREIGN KEY (id_transaksi)
    REFERENCES transaksi (id_transaksi)
    ON UPDATE CASCADE ON DELETE CASCADE,
  CONSTRAINT fk_dt_barang FOREIGN KEY (id_barang)
    REFERENCES barang (id_barang)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT chk_dt_jumlah CHECK (jumlah > 0),
  CONSTRAINT chk_dt_harga  CHECK (harga_jual >= 0)
) ENGINE=InnoDB;

-- 9. PENYESUAIAN_STOK (Barang 1 -- N Penyesuaian : MENCATAT)
CREATE TABLE penyesuaian_stok (
  id_penyesuaian    VARCHAR(10)  NOT NULL,
  jenis_penyesuaian ENUM('Tambah','Kurang') NOT NULL,
  tanggal           DATE         NOT NULL,
  jumlah            INT          NOT NULL,
  alasan            VARCHAR(255) NULL,
  id_barang         VARCHAR(10)  NOT NULL,
  PRIMARY KEY (id_penyesuaian),
  CONSTRAINT fk_ps_barang FOREIGN KEY (id_barang)
    REFERENCES barang (id_barang)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT chk_ps_jumlah CHECK (jumlah > 0)
) ENGINE=InnoDB;

-- 10. RETUR_PELANGGAN (DIAJUKAN DARI, MERETUR, MENYETUJUI)
CREATE TABLE retur_pelanggan (
  id_retur      VARCHAR(10)  NOT NULL,
  tanggal_retur DATE         NOT NULL,
  alasan        VARCHAR(255) NOT NULL,
  jumlah_retur  INT          NOT NULL,
  id_transaksi  VARCHAR(10)  NOT NULL,
  id_barang     VARCHAR(10)  NOT NULL,
  id_pemilik    VARCHAR(10)  NOT NULL,
  PRIMARY KEY (id_retur),
  CONSTRAINT fk_retur_transaksi FOREIGN KEY (id_transaksi)
    REFERENCES transaksi (id_transaksi)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT fk_retur_barang FOREIGN KEY (id_barang)
    REFERENCES barang (id_barang)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT fk_retur_pemilik FOREIGN KEY (id_pemilik)
    REFERENCES pemilik (id_pemilik)
    ON UPDATE CASCADE ON DELETE RESTRICT,
  CONSTRAINT chk_retur_jumlah CHECK (jumlah_retur > 0)
) ENGINE=InnoDB;

-- VIEW: TOTAL transaksi (atribut turunan)
CREATE VIEW v_transaksi_total AS
SELECT t.id_transaksi,
       t.tanggal,
       t.id_kasir,
       COALESCE(SUM(d.subtotal), 0) AS total
FROM transaksi t
LEFT JOIN detail_transaksi d ON d.id_transaksi = t.id_transaksi
GROUP BY t.id_transaksi, t.tanggal, t.id_kasir;


